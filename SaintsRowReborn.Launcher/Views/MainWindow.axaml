<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SaintsRowReborn.Launcher.ViewModels"
        mc:Ignorable="d" Width="800" Height="600" CanResize="False"
        x:Class="SaintsRowReborn.Launcher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/icon.ico"
        Title="Saints Row Reborn Launcher v1.0.0"
        Background="#121212" Foreground="#E0E0E0"
        FontFamily="Helvetica, Arial, sans-serif">

    <Window.Styles>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#333333" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        
        <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#555555" />
            <Setter Property="Foreground" Value="#CCCCCC" />
        </Style>
        
        <Style Selector="SelectableTextBlock">
            <Setter Property="SelectionBrush" Value="#555555" />
        </Style>

        <Style Selector="Border.cardOverlay">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.cardRoot:pointerover Border.cardOverlay">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
    </Window.Styles>

    <Grid>
        <Grid RowDefinitions="Auto, *, 200" IsVisible="{Binding !IsGalleryVisible}">
            <Border BorderBrush="#333333" BorderThickness="0,0,0,1" Grid.Row="0" Padding="20">
                <StackPanel Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                    <TextBlock FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Text="{Binding CurrentStepText}"/>
                    <Border Background="#333333" CornerRadius="4" IsVisible="{Binding IsOptional}" Padding="6,2">
                        <TextBlock FontSize="11" FontWeight="Bold" Foreground="#AAAAAA" Text="OPTIONAL" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>
            
            <Grid Grid.Row="1">
                <StackPanel HorizontalAlignment="Center" Spacing="20" VerticalAlignment="Center">
                    <TextBlock FontSize="16" MaxWidth="600" Text="{Binding StepDescription}" TextAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding !IsWaiting}"/>
                    
                    <StackPanel IsVisible="{Binding IsWaiting}" Margin="0,15,0,15" MinWidth="400">
                        <TextBlock Text="{Binding WaitRemainingText}" FontSize="18" FontWeight="Bold" Foreground="#FF8C00" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding WaitProgress}" Height="8" Foreground="#4DA6FF" Background="#333333" CornerRadius="4"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                        <Button Background="#FFFFFF" Command="{Binding ExecutePrimaryActionCommand}" Content="{Binding PrimaryButtonText}" CornerRadius="4" FontWeight="Bold" Foreground="#000000" Padding="30,12" IsEnabled="{Binding IsPrimaryEnabled}"/>
                        <Button Background="Transparent" BorderBrush="#888888" BorderThickness="1" Command="{Binding SkipStepCommand}" Content="{Binding SecondaryButtonText}" CornerRadius="4" FontWeight="Bold" Foreground="#888888" IsVisible="{Binding IsSkipButtonVisible}" Padding="20,12"/>
                        <Button Content="Gallery" Command="{Binding OpenGalleryCommand}" IsVisible="{Binding IsGalleryButtonVisible}" Background="#2A2A2A" Foreground="#FFFFFF" BorderBrush="#555555" BorderThickness="1" CornerRadius="4" FontWeight="Bold" Padding="30,12"/>
                    </StackPanel>
                    
                    <StackPanel HorizontalAlignment="Center" IsVisible="{Binding IsReadmeLinkVisible}" Margin="0,10,0,0" Orientation="Horizontal">
                        <TextBlock FontSize="12" Foreground="#AAAAAA" Text="Stuck on this step? " VerticalAlignment="Center"/>
                        <Button Classes="link" Background="Transparent" BorderThickness="0" Command="{Binding OpenReadmeCommand}" Content="Refer to the README." Cursor="Hand" FontSize="12" Foreground="#4DA6FF" Padding="0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                
                <TextBlock Text="Made by Adam Stark" Foreground="#444444" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="15"/>
            </Grid>
            
            <Border Background="#0A0A0A" BorderBrush="#333333" BorderThickness="0,1,0,0" Grid.Row="2">
                <Grid>
                    <ScrollViewer x:Name="TerminalScroll">
                        <SelectableTextBlock FontFamily="Consolas, Monaco, monospace" FontSize="12" Foreground="#AAAAAA" Padding="15" Text="{Binding TerminalOutput}" TextWrapping="Wrap"/>
                    </ScrollViewer>
                    <Button Command="{Binding CopyLogCommand}" Content="Copy" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="10" Background="#333333" Foreground="#FFFFFF" Padding="15,6" CornerRadius="4" Cursor="Hand" FontSize="12" FontWeight="Bold" ToolTip.Tip="Copy to clipboard"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Background="#121212" RowDefinitions="Auto, *" IsVisible="{Binding IsGalleryVisible}">
            <Grid Grid.Row="0" Margin="30,20" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="5">
                    <TextBlock Text="Reborn Gallery" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="{Binding CharacterCountText}" FontSize="14" Foreground="#AAAAAA"/>
                </StackPanel>
                
                <Button Content="Back" Command="{Binding CloseGalleryCommand}" Background="#333333" Foreground="White" FontWeight="Bold" Padding="20,10" CornerRadius="4" Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <TextBlock Grid.Row="1" Text="{Binding GalleryStatusText}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888888" IsVisible="{Binding IsGalleryLoading}"/>

            <ScrollViewer Grid.Row="1" Margin="20,0,20,20" IsVisible="{Binding !IsGalleryLoading}">
                <StackPanel HorizontalAlignment="Center" Spacing="20" Margin="0,0,0,20">
                    <ItemsControl ItemsSource="{Binding Characters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CharacterViewModel">
                                <Border Classes="cardRoot" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Margin="12" Width="260" Height="288" ClipToBounds="True" Background="#0A0A0A">
                                    <Grid>
                                        <Border CornerRadius="8" ClipToBounds="True">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        
                                        <Border Classes="cardOverlay" Background="#E6121212" CornerRadius="8">
                                            <StackPanel VerticalAlignment="Center" Spacing="15" Margin="20">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="Uploaded by:" FontSize="14" Foreground="#FFFFFF" TextAlignment="Center"/>
                                                    <TextBlock Text="{Binding PsnOnlineId}" FontSize="16" FontWeight="Bold" Foreground="#4DA6FF" TextAlignment="Center" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding DateText}" FontSize="12" Foreground="#AAAAAA" TextAlignment="Center" Margin="0,5,0,0"/>
                                                </StackPanel>
                                                <Button Content="Download" Command="{Binding $parent[Window].DataContext.DownloadCharacterCommand}" x:CompileBindings="False" CommandParameter="{Binding}" Background="#4DA6FF" Foreground="#000000" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,10" CornerRadius="4" Cursor="Hand"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <Button Content="View More" Command="{Binding LoadMoreCommand}" IsVisible="{Binding CanLoadMore}" Background="#333333" Foreground="#FFFFFF" FontWeight="Bold" Padding="40,12" CornerRadius="4" Cursor="Hand" HorizontalAlignment="Center"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Background="#CC000000" IsVisible="{Binding IsGithubPopupVisible}" ZIndex="30">
            <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                <StackPanel Spacing="15" HorizontalAlignment="Center">
                    <TextBlock Text="GitHub Authorization" FontWeight="Bold" FontSize="20" Foreground="#FF8C00" HorizontalAlignment="Center"/>
                    <TextBlock Text="To instantly bypass the wait time, please authorize with GitHub and star the repo. Click the code below to copy it:" TextWrapping="Wrap" TextAlignment="Center" Foreground="#AAAAAA"/>
                    <Button Command="{Binding CopyGithubCodeCommand}" Background="#2A2A2A" CornerRadius="6" Padding="20,10" HorizontalAlignment="Center" Cursor="Hand" ToolTip.Tip="Click to copy code">
                        <TextBlock Text="{Binding GithubUserCode}" FontWeight="Bold" FontSize="28" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                    </Button>
                    <Button Content="Open Verification Page" Command="{Binding OpenGithubAuthCommand}" Background="#4DA6FF" Foreground="#000000" FontWeight="Bold" HorizontalAlignment="Center" Padding="20,10" CornerRadius="4"/>
                    <TextBlock Text="{Binding GithubAuthMessage}" Foreground="#888888" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"/>
                    <Button Content="Skip &amp; Wait" Command="{Binding SkipGithubAuthCommand}" Background="Transparent" Foreground="#AAAAAA" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>